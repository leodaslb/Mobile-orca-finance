{
  "name": "orca-finance-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API do Orca Finance — bootstrap técnico",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "test": "jest --runInBand",
    "test:e2e": "jest --runInBand --config jest.e2e.config.cjs",
    "lint": "eslint \"{src,test}/**/*.ts\" prisma.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "seed": "npm run prisma:generate && npm run build && node prisma/seed.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-fastify": "11.2.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "prisma": "7.10.0",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
